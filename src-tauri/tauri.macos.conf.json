{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bakbak",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "shadow": true,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        },
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        },
        "zoomHotkeysEnabled": true,
        "backgroundThrottling": "disabled",
        "allowLinkPreview": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": ["dmg"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
