{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bakbak",
  "version": "2.0.0",
  "identifier": "com.bakbak.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Bakbak",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "shadow": true,
        "zoomHotkeysEnabled": true,
        "backgroundThrottling": "disabled",
        "allowLinkPreview": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:; font-src 'self' data:; frame-src https://www.youtube-nocookie.com; img-src 'self' data: blob: https://*.giphy.com https://i.ytimg.com; media-src 'self' data: blob: https://*.giphy.com; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "SocialNetworking",
    "icon": [
      "../build/icons/32x32.png",
      "../build/icons/128x128.png",
      "../build/icons/128x128@2x.png",
      "../build/icons/icon.icns",
      "../build/icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bakbak"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IEU2NTA0MTVEQ0Q0N0QzRDgKUldUWTAwZk5YVUZRNWdnQkxzRmttc0VKcDhTRWhTVjVXaTlQK3RKUEhXS3B4d2JPK1dIRysxTkcK",
      "endpoints": [
        "https://github.com/ayushrameja/bakbak/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
